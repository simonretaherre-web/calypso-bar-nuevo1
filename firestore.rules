
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == "publicidadherrera@gmail.com"
          || request.auth.token.email == "simonretaherre@gmail.com"
        );
    }

    // Carta pública: los invitados pueden leerla.
    match /recipesPublic/{recipeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Preparaciones privadas: solo las cuentas autorizadas.
    match /recipesPrivate/{recipeId} {
      allow read, write: if isAdmin();
    }

    // Inventario privado: solo las cuentas autorizadas.
    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    // Historial privado y permanente de movimientos de inventario.
    match /inventoryMovements/{movementId} {
      allow read, write: if isAdmin();
    }

    // Inventario privado de cristalería: solo administradores autorizados.
    match /glasswareInventory/{itemId} {
      allow read, write: if isAdmin();
    }

    // Tickets privados de entradas de cristalería.
    match /glasswareTickets/{ticketId} {
      allow read, write: if isAdmin();
    }

    // Bloquear el acceso a cualquier otra colección.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
